    "pug": "~3.0.3",
    "uuid": "^11.1.1",
    "compression": "~1.8.2",
    "express-validator": "~7.3.2",
    "morgan": "~1.12.0",
    "redis": "^0.12.1",
    "lru-cache": "^2.6.4",
