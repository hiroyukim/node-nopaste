{
  "name": "node-nopaste",
  "version": "0.1.8",
  "description": "node-nopaste is a server that shares a temporary code .",
  "main": "app.js",
  "bin": {
    "post-node-nopaste": "./bin/post-node-nopaste",
    "node-nopaste": "./bin/node-nopaste"
  },
  "scripts": {
    "start": "node ./bin/node-nopaste"
