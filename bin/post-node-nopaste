#!/usr/bin/env node
'use strict';
var http        = require('http'),
    https       = require('https'),
    fs          = require('fs'),
    url         = require('url'),
    querystring = require('querystring'),
    program     = require('commander');

program
    .usage('<filepath>')
    .option('-h, --host <hostname>', 'Set host','localhost')
    .option('-p, --port <number>', 'Set port',3000)
    .option('-s, --scheme <http|https>', 'Set scheme','http')
    .parse(process.argv);

var filepath = program.args[0];

if(!filepath) {
    program.help();
}

var host   = program.host,
    port   = program.port,
    scheme = program.scheme;

var contents = fs.readFileSync(filepath);

var postBody = querystring.stringify({ data: contents.toString() });

var client = scheme === 'https' ? https : http;

var req = client.request({
    hostname: host,
    port: port,
    path: '/add',
    method: 'POST',
    headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Content-Length': Buffer.byteLength(postBody)
    }
}, function(httpResponse){
    httpResponse.resume();

    var response_location     = url.parse(httpResponse.headers.location || '');
    var node_nopaste_show_url = url.format({
        protocol: scheme,
        hostname: host,
        port: port,
        search: response_location.search,
        pathname : response_location.pathname
    });
    console.log(node_nopaste_show_url);
});

req.on('error', function(err){
    console.warn(err);
    process.exit(1);
});

req.write(postBody);
req.end();
